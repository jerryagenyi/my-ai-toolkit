{
  "description": "Example hooks configuration — copy the relevant blocks into your project's .claude/settings.json under \"hooks\". This file previously used an outdated schema (user-prompt-submit-hook/stop-hook as flat command+args objects) that Claude Code never actually read — fixed 2026-10-20 after discovering it live in a real project. Current schema: event name -> array of {hooks: [{type: \"command\", command: \"...\"}]}.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo Troubleshooting a bug or regression this session? Read docs/tech/incident-log.md (or your project's equivalent) first - it records what has already been tried and why it did or didn't work."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/incident-retro.py"
          },
          {
            "type": "command",
            "command": "bash scripts/reflect-auto.sh"
          }
        ]
      }
    ]
  }
}
